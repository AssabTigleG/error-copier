# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# VS Code test runner and cache
.vscode-test/
.vscode-test/**

# VSIX extension packages
*.vsix

# VS Code settings (whitelist common config)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Local History and temporary files
.history/
.DS_Store
Thumbs.db
*.tmp
*.log

# Build & OS caches
.eslintcache
