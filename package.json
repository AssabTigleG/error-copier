{
    "name": "error-copier",
    "displayName": "Error Copier",
    "description": "Scans for diagnostics, displays them in a sidebar with grouping & filtering, an interactive panel, or copies them with context to the clipboard.",
    "version": "1.5.0",
    "publisher": "AssabTigle",
    "icon": "images/errorLogo.png",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Linters",
        "Other"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/AssabTigleG/error-copier.git"
    },
    "activationEvents": [
        "onView:errorContextCopierDiagnosticsView",
        "onCommand:errorcontextcopier.scanSubfoldersAndCopy",
        "onCommand:errorcontextcopier.scanWorkspaceAndCopy",
        "onCommand:errorcontextcopier.scanActiveFileAndCopy",
        "onCommand:errorcontextcopier.scanExplorerSelectionAndCopy",
        "onCommand:errorcontextcopier.scanAndShowInPanel",
        "onCommand:errorcontextcopier.scanAndExportReportAs",
        "onCommand:errorcontextcopier.refreshDiagnosticsView",
        "onCommand:errorcontextcopier.view.scanWorkspaceAndShowPanel",
        "onCommand:errorcontextcopier.view.scanWorkspaceAndExportAs",
        "onCommand:errorcontextcopier.view.defineScanScopeAndShowPanel",
        "onCommand:errorcontextcopier.view.setTreeFilter",
        "onCommand:errorcontextcopier.view.clearTreeFilter",
        "onCommand:errorcontextcopier.view.switchGroupingMode",
        "onCommand:errorcontextcopier.focusDiagnosticsView",
        "onCommand:errorcontextcopier.tree.goToDiagnostic",
        "onCommand:errorcontextcopier.tree.copyDiagnosticMessage",
        "onCommand:errorcontextcopier.tree.scanFileForPanel",
        "onCommand:errorcontextcopier.tree.scanFileForClipboard"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "error-context-copier-view-container",
                    "title": "Error Context",
                    "icon": "images/activity-bar-icon.svg"
                }
            ]
        },
        "views": {
            "error-context-copier-view-container": [
                {
                    "id": "errorContextCopierDiagnosticsView",
                    "name": "Diagnostics",
                    "icon": "$(list-tree)",
                    "contextualTitle": "Error Context Diagnostics"
                }
            ]
        },
        "commands": [
            {
                "command": "errorcontextcopier.refreshDiagnosticsView",
                "title": "Refresh Diagnostics",
                "icon": "$(refresh)"
            },
            {
                "command": "errorcontextcopier.view.switchGroupingMode",
                "title": "Switch Grouping Mode (File / Severity / Rule)",
                "icon": "$(group-by-ref-type)"
            },
            {
                "command": "errorcontextcopier.view.toggleSeverities",
                "title": "Filter Displayed Severities (Errors / Warnings / Infos / Hints)",
                "icon": "$(checklist)"
            },
            {
                "command": "errorcontextcopier.view.toggleGeneratedFiles",
                "title": "Toggle Hide/Show Generated Code (*.g.dart, *.min.js, etc.)",
                "icon": "$(exclude)"
            },
            {
                "command": "errorcontextcopier.view.groupByFile",
                "title": "Error Copier: Group Diagnostics by File"
            },
            {
                "command": "errorcontextcopier.view.groupBySeverity",
                "title": "Error Copier: Group Diagnostics by Severity"
            },
            {
                "command": "errorcontextcopier.view.groupBySourceRule",
                "title": "Error Copier: Group Diagnostics by Diagnostic Source / Rule"
            },
            {
                "command": "errorcontextcopier.focusDiagnosticsView",
                "title": "Error Copier: Focus Diagnostics View"
            },
            {
                "command": "errorcontextcopier.view.defineScanScopeAndShowPanel",
                "title": "Scan Defined Scope & Show Panel",
                "icon": "$(folder-opened)"
            },
            {
                "command": "errorcontextcopier.view.scanWorkspaceAndShowPanel",
                "title": "Scan Workspace & Show Panel",
                "icon": "$(window)"
            },
            {
                "command": "errorcontextcopier.view.scanWorkspaceAndExportAs",
                "title": "Scan Workspace & Export As...",
                "icon": "$(export)"
            },
            {
                "command": "errorcontextcopier.view.setTreeFilter",
                "title": "Filter Diagnostics Tree...",
                "icon": "$(filter)"
            },
            {
                "command": "errorcontextcopier.view.clearTreeFilter",
                "title": "Clear Diagnostics Tree Filter",
                "icon": "$(clear-all)"
            },
            {
                "command": "errorcontextcopier.scanWorkspaceAndCopy",
                "title": "Error Copier: Copy Workspace Report"
            },
            {
                "command": "errorcontextcopier.scanActiveFileAndCopy",
                "title": "Error Copier: Copy Active File Report"
            },
            {
                "command": "errorcontextcopier.scanSubfoldersAndCopy",
                "title": "Error Copier: Copy Selected Subfolders Report"
            },
            {
                "command": "errorcontextcopier.copyErrorsOnly",
                "title": "Copy Errors Only",
                "icon": "$(error)"
            },
            {
                "command": "errorcontextcopier.copyWarningsOnly",
                "title": "Copy Warnings Only",
                "icon": "$(warning)"
            },
            {
                "command": "errorcontextcopier.copyAllDiagnostics",
                "title": "Copy All Diagnostics",
                "icon": "$(checklist)"
            },
            {
                "command": "errorcontextcopier.copyAsAiPrompt",
                "title": "Copy as AI Fix Prompt",
                "icon": "$(sparkle)"
            },
            {
                "command": "errorcontextcopier.openReportPanel",
                "title": "Open in Report Panel",
                "icon": "$(window)"
            },
            {
                "command": "errorcontextcopier.scanAndShowInPanel",
                "title": "Error Copier: Open Report Panel"
            },
            {
                "command": "errorcontextcopier.scanAndExportReportAs",
                "title": "Error Copier: Export Report As..."
            },
            {
                "command": "errorcontextcopier.tree.autoFixDiagnostic",
                "title": "Auto Fix (Quick Fix...)",
                "icon": "$(lightbulb-autofix)"
            },
            {
                "command": "errorcontextcopier.tree.goToDiagnostic",
                "title": "Jump to Code",
                "icon": "$(go-to-file)"
            },
            {
                "command": "errorcontextcopier.tree.copyDiagnosticWithContext",
                "title": "Copy Snippet with Context",
                "icon": "$(copy)"
            },
            {
                "command": "errorcontextcopier.tree.copyDiagnosticMessage",
                "title": "Copy Message Only",
                "icon": "$(quote)"
            },
            {
                "command": "errorcontextcopier.tree.copyDiagnosticAsAiPrompt",
                "title": "Copy as AI Fix Prompt",
                "icon": "$(sparkle)"
            },
            {
                "command": "errorcontextcopier.tree.copyFileErrors",
                "title": "Copy Errors Only",
                "icon": "$(error)"
            },
            {
                "command": "errorcontextcopier.tree.copyFileWarnings",
                "title": "Copy Warnings Only",
                "icon": "$(warning)"
            },
            {
                "command": "errorcontextcopier.tree.copyFileAll",
                "title": "Copy All Diagnostics",
                "icon": "$(checklist)"
            },
            {
                "command": "errorcontextcopier.tree.copyFileAsAiPrompt",
                "title": "Copy as AI Fix Prompt",
                "icon": "$(sparkle)"
            },
            {
                "command": "errorcontextcopier.tree.fixAllInFile",
                "title": "Fix All in File (Quick Fix)",
                "icon": "$(wand)"
            },
            {
                "command": "errorcontextcopier.tree.scanFileForPanel",
                "title": "Open in Report Panel",
                "icon": "$(window)"
            }
        ],
        "submenus": [
            {
                "id": "errorcontextcopier.submenu",
                "label": "Error Copier",
                "icon": "$(copy)"
            }
        ],
        "menus": {
            "errorcontextcopier.submenu": [
                {
                    "command": "errorcontextcopier.copyErrorsOnly",
                    "group": "1_copy@1"
                },
                {
                    "command": "errorcontextcopier.copyWarningsOnly",
                    "group": "1_copy@2"
                },
                {
                    "command": "errorcontextcopier.copyAllDiagnostics",
                    "group": "1_copy@3"
                },
                {
                    "command": "errorcontextcopier.copyAsAiPrompt",
                    "group": "2_ai@1"
                },
                {
                    "command": "errorcontextcopier.openReportPanel",
                    "group": "3_open@1"
                }
            ],
            "explorer/context": [
                {
                    "command": "errorcontextcopier.copyErrorsOnly",
                    "group": "navigation@1"
                },
                {
                    "submenu": "errorcontextcopier.submenu",
                    "group": "navigation@2"
                }
            ],
            "editor/context": [
                {
                    "command": "errorcontextcopier.copyErrorsOnly",
                    "group": "navigation@1"
                },
                {
                    "submenu": "errorcontextcopier.submenu",
                    "group": "navigation@2"
                }
            ],
            "view/title": [
                {
                    "command": "errorcontextcopier.view.switchGroupingMode",
                    "when": "view == errorContextCopierDiagnosticsView",
                    "group": "navigation@0"
                },
                {
                    "command": "errorcontextcopier.view.toggleSeverities",
                    "when": "view == errorContextCopierDiagnosticsView",
                    "group": "navigation@1"
                },
                {
                    "command": "errorcontextcopier.view.toggleGeneratedFiles",
                    "when": "view == errorContextCopierDiagnosticsView",
                    "group": "navigation@1"
                },
                {
                    "command": "errorcontextcopier.view.setTreeFilter",
                    "when": "view == errorContextCopierDiagnosticsView && !errorContextCopier.treeFilterActive",
                    "group": "navigation@1"
                },
                {
                    "command": "errorcontextcopier.view.clearTreeFilter",
                    "when": "view == errorContextCopierDiagnosticsView && errorContextCopier.treeFilterActive",
                    "group": "navigation@1"
                },
                {
                    "command": "errorcontextcopier.refreshDiagnosticsView",
                    "when": "view == errorContextCopierDiagnosticsView",
                    "group": "navigation@2"
                },
                {
                    "command": "errorcontextcopier.view.defineScanScopeAndShowPanel",
                    "when": "view == errorContextCopierDiagnosticsView",
                    "group": "navigation@3"
                },
                {
                    "command": "errorcontextcopier.view.scanWorkspaceAndShowPanel",
                    "when": "view == errorContextCopierDiagnosticsView",
                    "group": "navigation@4"
                },
                {
                    "command": "errorcontextcopier.view.scanWorkspaceAndExportAs",
                    "when": "view == errorContextCopierDiagnosticsView",
                    "group": "navigation@5"
                }
            ],
            "view/item/context": [
                {
                    "command": "errorcontextcopier.tree.autoFixDiagnostic",
                    "when": "view == errorContextCopierDiagnosticsView && viewItem == diagnosticItem",
                    "group": "inline@1"
                },
                {
                    "command": "errorcontextcopier.tree.goToDiagnostic",
                    "when": "view == errorContextCopierDiagnosticsView && viewItem == diagnosticItem",
                    "group": "inline@2"
                },
                {
                    "command": "errorcontextcopier.tree.autoFixDiagnostic",
                    "when": "view == errorContextCopierDiagnosticsView && viewItem == diagnosticItem",
                    "group": "1_fix@1"
                },
                {
                    "command": "errorcontextcopier.tree.copyDiagnosticWithContext",
                    "when": "view == errorContextCopierDiagnosticsView && viewItem == diagnosticItem",
                    "group": "2_copy@1"
                },
                {
                    "command": "errorcontextcopier.tree.copyDiagnosticMessage",
                    "when": "view == errorContextCopierDiagnosticsView && viewItem == diagnosticItem",
                    "group": "1_copy@2"
                },
                {
                    "command": "errorcontextcopier.tree.copyDiagnosticAsAiPrompt",
                    "when": "view == errorContextCopierDiagnosticsView && viewItem == diagnosticItem",
                    "group": "2_ai@1"
                },
                {
                    "command": "errorcontextcopier.tree.fixAllInFile",
                    "when": "view == errorContextCopierDiagnosticsView && viewItem == fileItem",
                    "group": "1_fix@1"
                },
                {
                    "command": "errorcontextcopier.tree.copyFileErrors",
                    "when": "view == errorContextCopierDiagnosticsView && viewItem == fileItem",
                    "group": "2_copy@1"
                },
                {
                    "command": "errorcontextcopier.tree.copyFileWarnings",
                    "when": "view == errorContextCopierDiagnosticsView && viewItem == fileItem",
                    "group": "1_copy@2"
                },
                {
                    "command": "errorcontextcopier.tree.copyFileAll",
                    "when": "view == errorContextCopierDiagnosticsView && viewItem == fileItem",
                    "group": "1_copy@3"
                },
                {
                    "command": "errorcontextcopier.tree.copyFileAsAiPrompt",
                    "when": "view == errorContextCopierDiagnosticsView && viewItem == fileItem",
                    "group": "2_ai@1"
                },
                {
                    "command": "errorcontextcopier.tree.scanFileForPanel",
                    "when": "view == errorContextCopierDiagnosticsView && viewItem == fileItem",
                    "group": "3_open@1"
                }
            ]
        },
        "configuration": {
            "title": "Error Context Copier",
            "properties": {
                "errorcontextcopier.defaultGroupingMode": {
                    "type": "string",
                    "enum": [
                        "file",
                        "severity",
                        "sourceRule"
                    ],
                    "enumDescriptions": [
                        "Group diagnostics by workspace folder and file hierarchy",
                        "Group diagnostics by severity level (Errors, Warnings, Information, Hints)",
                        "Group diagnostics by linter/compiler source and rule code (e.g., eslint: no-unused-vars, ts: 2304)"
                    ],
                    "default": "file",
                    "description": "Default grouping mode for diagnostics displayed in the sidebar TreeView."
                },
                "errorcontextcopier.statusBar.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show live diagnostic summary badge in the status bar."
                },
                "errorcontextcopier.ignoreGeneratedFiles": {
                    "type": "boolean",
                    "default": false,
                    "description": "Hide generated code files (*.g.dart, *.freezed.dart, *.min.js, etc.) from the sidebar tree."
                },
                "errorcontextcopier.asyncChunkSize": {
                    "type": "integer",
                    "default": 50,
                    "minimum": 1,
                    "description": "Number of files to scan per asynchronous batch to avoid UI freezes on large codebases."
                },
                "errorcontextcopier.contextLinesBefore": {
                    "type": "integer",
                    "default": 1,
                    "minimum": 0,
                    "description": "Number of context lines to include before each error/group in the report."
                },
                "errorcontextcopier.contextLinesAfter": {
                    "type": "integer",
                    "default": 1,
                    "minimum": 0,
                    "description": "Number of context lines to include after each error/group in the report."
                },
                "errorcontextcopier.includeSeverities": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "Error",
                            "Warning",
                            "Information",
                            "Hint"
                        ]
                    },
                    "default": [
                        "Error",
                        "Warning"
                    ],
                    "description": "Diagnostic severities to include in the scan."
                },
                "errorcontextcopier.ignoredErrorCodes": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Array of error codes (e.g., \"ts2304\", \"eslint(no-unused-vars)\") to ignore."
                },
                "errorcontextcopier.ignoredErrorMessages": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Array of strings or /regex/ patterns for error messages to ignore."
                },
                "errorcontextcopier.groupingLineThreshold": {
                    "type": "integer",
                    "default": 2,
                    "minimum": 0,
                    "description": "Max lines between diagnostics to be in the same group."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile",
        "test": "node ./out/test/runTest.js",
        "test:unit": "mocha --ui tdd out/test/unit/**/*.test.js",
        "package": "vsce package",
        "lint": "eslint src --ext ts"
    },
    "devDependencies": {
        "@types/glob": "^8.1.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "18.x",
        "@types/vscode": "^1.80.0",
        "@typescript-eslint/eslint-plugin": "^5.59.8",
        "@typescript-eslint/parser": "^5.59.8",
        "@vscode/test-electron": "^2.4.1",
        "eslint": "^8.41.0",
        "mocha": "^10.8.2",
        "typescript": "^5.0.0"
    }
}
